import math
from datetime import datetime, timedelta
from typing import List, Dict, Optional


class QuickCalc:
    """Встроенный кредитный калькулятор"""

    def __init__(self):
        self.loan_history = []

    def calculate_monthly_payment(
            self,
            loan_amount: float,
            annual_rate: float,
            loan_term_years: int,
            payment_type: str = "annuity"
    ) -> Dict:
        """Рассчитать примерный ежемесячный платёж"""
        monthly_rate = annual_rate / 100 / 12
        months = loan_term_years * 12

        if payment_type == "annuity":
            if monthly_rate == 0:
                monthly_payment = loan_amount / months
            else:
                monthly_payment = loan_amount * monthly_rate * math.pow(1 + monthly_rate, months) / (
                            math.pow(1 + monthly_rate, months) - 1)

            total_payment = monthly_payment * months
            overpayment = total_payment - loan_amount

            return {
                "monthly_payment": round(monthly_payment, 2),
                "total_payment": round(total_payment, 2),
                "overpayment": round(overpayment, 2),
                "payment_type": "аннуитетный",
                "details": f"Ежемесячный платёж: {round(monthly_payment, 2)} ₽"
            }

        else:
            payments = []
            remaining_debt = loan_amount
            main_debt_part = loan_amount / months
            total_payment = 0

            for month in range(1, months + 1):
                interest_part = remaining_debt * monthly_rate
                monthly_payment = main_debt_part + interest_part
                total_payment += monthly_payment
                payments.append(monthly_payment)
                remaining_debt -= main_debt_part

            first_payment = payments[0]
            last_payment = payments[-1]
            avg_payment = total_payment / months
            overpayment = total_payment - loan_amount

            return {
                "first_payment": round(first_payment, 2),
                "last_payment": round(last_payment, 2),
                "avg_payment": round(avg_payment, 2),
                "total_payment": round(total_payment, 2),
                "overpayment": round(overpayment, 2),
                "payment_type": "дифференцированный",
                "details": f"Первый платёж: {round(first_payment, 2)} ₽, последний: {round(last_payment, 2)} ₽"
            }

    def generate_payment_schedule(
            self,
            loan_amount: float,
            annual_rate: float,
            loan_term_years: int,
            start_date: Optional[datetime] = None,
            payment_type: str = "annuity"
    ) -> List[Dict]:
        """Показать график платежей"""
        if start_date is None:
            start_date = datetime.now()

        monthly_rate = annual_rate / 100 / 12
        months = loan_term_years * 12

        schedule = []
        remaining_debt = loan_amount

        if payment_type == "annuity":
            if monthly_rate == 0:
                monthly_payment = loan_amount / months
            else:
                monthly_payment = loan_amount * monthly_rate * math.pow(1 + monthly_rate, months) / (
                            math.pow(1 + monthly_rate, months) - 1)

            for month in range(1, months + 1):
                interest_part = remaining_debt * monthly_rate
                main_debt_part = monthly_payment - interest_part

                if month == months:
                    main_debt_part = remaining_debt
                    monthly_payment = main_debt_part + interest_part

                remaining_debt -= main_debt_part

                payment_date = start_date + timedelta(days=30 * month)

                schedule.append({
                    "month": month,
                    "date": payment_date.strftime("%d.%m.%Y"),
                    "payment": round(monthly_payment, 2),
                    "main_debt": round(main_debt_part, 2),
                    "interest": round(interest_part, 2),
                    "remaining_debt": round(max(remaining_debt, 0), 2)
                })

        else:
            main_debt_part = loan_amount / months

            for month in range(1, months + 1):
                interest_part = remaining_debt * monthly_rate
                monthly_payment = main_debt_part + interest_part
                remaining_debt -= main_debt_part

                payment_date = start_date + timedelta(days=30 * month)

                schedule.append({
                    "month": month,
                    "date": payment_date.strftime("%d.%m.%Y"),
                    "payment": round(monthly_payment, 2),
                    "main_debt": round(main_debt_part, 2),
                    "interest": round(interest_part, 2),
                    "remaining_debt": round(max(remaining_debt, 0), 2)
                })

        return schedule

    def refinancing_benefit(
            self,
            current_loan: Dict,
            new_rate: float,
            new_term_years: Optional[int] = None,
            early_repayment: float = 0
    ) -> Dict:
        """Подсказать выгоду рефинансирования"""
        remaining_debt = current_loan.get('remaining_debt', 0)
        current_rate = current_loan.get('annual_rate', 0)
        remaining_months = current_loan.get('remaining_months', 0)

        remaining_debt -= early_repayment

        if new_term_years is None:
            new_term_years = remaining_months / 12

        monthly_rate_current = current_rate / 100 / 12
        if monthly_rate_current == 0:
            current_monthly_payment = remaining_debt / remaining_months
        else:
            current_monthly_payment = remaining_debt * monthly_rate_current * math.pow(1 + monthly_rate_current,
                                                                                       remaining_months) / (
                                                  math.pow(1 + monthly_rate_current, remaining_months) - 1)

        current_total_payment = current_monthly_payment * remaining_months

        new_months = new_term_years * 12
        monthly_rate_new = new_rate / 100 / 12

        if monthly_rate_new == 0:
            new_monthly_payment = remaining_debt / new_months
        else:
            new_monthly_payment = remaining_debt * monthly_rate_new * math.pow(1 + monthly_rate_new, new_months) / (
                        math.pow(1 + monthly_rate_new, new_months) - 1)

        new_total_payment = new_monthly_payment * new_months

        monthly_saving = current_monthly_payment - new_monthly_payment
        total_saving = current_total_payment - new_total_payment

        benefit_percentage = (total_saving / current_total_payment * 100) if current_total_payment > 0 else 0

        return {
            "current_monthly_payment": round(current_monthly_payment, 2),
            "new_monthly_payment": round(new_monthly_payment, 2),
            "monthly_saving": round(monthly_saving, 2),
            "total_saving": round(total_saving, 2),
            "benefit_percentage": round(benefit_percentage, 2),
            "recommendation": "Рекомендуется рефинансирование" if total_saving > 0 else "Рефинансирование невыгодно"
        }


def get_float_input(prompt: str, default: float = None) -> float:
    """Получить число с плавающей точкой от пользователя"""
    while True:
        try:
            value = input(prompt)
            if default is not None and value == "":
                return default
            value = float(value.replace(',', '.').replace(' ', ''))
            if value < 0:
                print("❌ Значение не может быть отрицательным!")
                continue
            return value
        except ValueError:
            print("❌ Пожалуйста, введите число!")


def get_int_input(prompt: str, default: int = None, min_val: int = 1) -> int:
    """Получить целое число от пользователя"""
    while True:
        try:
            value = input(prompt)
            if default is not None and value == "":
                return default
            value = int(value)
            if value < min_val:
                print(f"❌ Значение должно быть не менее {min_val}!")
                continue
            return value
        except ValueError:
            print("❌ Пожалуйста, введите целое число!")


def get_choice_input(prompt: str, choices: list) -> str:
    """Получить выбор из вариантов"""
    while True:
        choice = input(prompt).lower()
        if choice in choices:
            return choice
        print(f"❌ Пожалуйста, выберите один из: {', '.join(choices)}")


